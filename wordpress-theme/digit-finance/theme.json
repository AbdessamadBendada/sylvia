{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": false,
    "layout": {
      "contentSize": "960px",
      "wideSize": "1540px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "custom": false,
      "customGradient": false,
      "palette": [
        { "slug": "navy", "color": "#07004d", "name": "Navy" },
        { "slug": "blue", "color": "#0000fe", "name": "Blue" },
        { "slug": "orange", "color": "#ff6819", "name": "Orange" },
        { "slug": "paper", "color": "#f7f6f1", "name": "Paper" },
        { "slug": "white", "color": "#fafafa", "name": "White" },
        { "slug": "muted", "color": "#69697a", "name": "Muted" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw", "vh"],
      "spacingSizes": [
        { "slug": "xs", "size": "clamp(0.75rem, 1vw, 1rem)", "name": "Extra small" },
        { "slug": "s", "size": "clamp(1rem, 1.6vw, 1.5rem)", "name": "Small" },
        { "slug": "m", "size": "clamp(1.5rem, 3vw, 3rem)", "name": "Medium" },
        { "slug": "l", "size": "clamp(3rem, 7vw, 6.75rem)", "name": "Large" },
        { "slug": "xl", "size": "clamp(5rem, 12vw, 12rem)", "name": "Extra large" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": false,
      "fluid": true,
      "fontFamilies": [
        { "fontFamily": "\"DM Sans\", sans-serif", "slug": "body", "name": "DM Sans" },
        { "fontFamily": "\"Stack Sans Headline\", \"Arial Black\", sans-serif", "slug": "display", "name": "Stack Sans Headline" }
      ],
      "fontSizes": [
        { "slug": "label", "size": "0.78rem", "name": "Label" },
        { "slug": "small", "size": "0.86rem", "name": "Small" },
        { "slug": "body", "size": "1rem", "name": "Body" },
        { "slug": "heading", "size": "clamp(2.2rem, 5.05vw, 5.95rem)", "name": "Heading" },
        { "slug": "display", "size": "clamp(2.85rem, 6vw, 6.2rem)", "name": "Display" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|paper",
      "text": "var:preset|color|navy"
    },
    "spacing": {
      "blockGap": "0"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|body",
      "lineHeight": "1.5"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "500",
          "lineHeight": "1"
        }
      },
      "link": {
        "color": { "text": "inherit" },
        "typography": { "textDecoration": "none" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
