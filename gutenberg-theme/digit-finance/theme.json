{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": false,
      "customGradient": false,
      "palette": [
        { "slug": "navy", "color": "#07004d", "name": "Navy" },
        { "slug": "blue", "color": "#0000fe", "name": "Blue" },
        { "slug": "orange", "color": "#ff6819", "name": "Orange" },
        { "slug": "paper", "color": "#f7f6f1", "name": "Paper" },
        { "slug": "white", "color": "#fafafa", "name": "White" },
        { "slug": "muted", "color": "#69697a", "name": "Muted" }
      ]
    },
    "layout": { "contentSize": "960px", "wideSize": "1540px" },
    "spacing": {
      "units": [ "px", "rem", "%", "vw", "vh" ],
      "spacingSizes": [
        { "slug": "xs", "size": "clamp(0.75rem, 1vw, 1rem)", "name": "Extra small" },
        { "slug": "s", "size": "clamp(1rem, 1.6vw, 1.5rem)", "name": "Small" },
        { "slug": "m", "size": "clamp(1.5rem, 3vw, 3rem)", "name": "Medium" },
        { "slug": "l", "size": "clamp(3rem, 7vw, 6.75rem)", "name": "Large" },
        { "slug": "xl", "size": "clamp(5rem, 12vw, 12rem)", "name": "Extra large" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "fontFamilies": [
        { "fontFamily": "'DM Sans', sans-serif", "slug": "body", "name": "DM Sans" },
        { "fontFamily": "'Stack Sans Headline', 'Arial Black', sans-serif", "slug": "display", "name": "Stack Sans Headline" }
      ],
      "fontSizes": [
        { "slug": "body", "size": "1rem", "name": "Body" },
        { "slug": "small", "size": "0.72rem", "name": "Small" },
        { "slug": "display", "size": "clamp(3.75rem, 11.2vw, 10.8rem)", "name": "Display" },
        { "slug": "heading", "size": "clamp(2.8rem, 6.6vw, 6.25rem)", "name": "Heading" }
      ]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": { "background": "var:preset|color|paper", "text": "var:preset|color|navy" },
    "spacing": { "padding": { "left": "clamp(20px, 3.2vw, 54px)", "right": "clamp(20px, 3.2vw, 54px)" } },
    "typography": { "fontFamily": "var:preset|font-family|body", "lineHeight": "1.5" },
    "elements": {
      "heading": { "typography": { "fontFamily": "var:preset|font-family|display", "fontWeight": "700", "lineHeight": "0.9" } },
      "link": { "typography": { "textDecoration": "none" } },
      "button": { "border": { "radius": "999px", "width": "1px" }, "spacing": { "padding": { "top": "0.85rem", "right": "1.25rem", "bottom": "0.85rem", "left": "1.25rem" } } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
